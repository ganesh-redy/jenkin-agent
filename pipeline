pipeline {
    agent none  // No global agent, stages will have specific agents

    stages {
        stage('Build') {
            agent { label 'node1' }  // Use node1 for this stage
            steps {
                // Create a directory as part of the build step
                sh ''' 
                mkdir -p /home/jenkins/hello  // Using a directory with proper permissions
                '''
            }
        }

        stage('Test') {
            agent { label 'node1' }  // Use node1 for this stage
            steps {
                // Listing the contents of /home/jenkins directory
                sh ''' 
                ls /home/jenkins
                '''
            }
        }

        stage('Deploy') {
            agent { label 'node1' }  // Use node1 for this stage
            steps {
                // Print a success message
                echo "Directory created and build successful" 
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}

